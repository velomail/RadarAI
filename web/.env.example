# =============================================================================
# RadarAI SaaS — environment variables (Vercel + local dev)
# =============================================================================
#
# Local:  cp .env.example .env.local
# Vercel: Project → Settings → Environment Variables (Root Directory = web/)
#         Add every REQUIRED variable below for Production + Preview.
#
# Setup guide:  ../docs/CONNECT_SERVICES.md  (demo mode by default)
# Docs:         ../docs/PROVISIONING.md  |  ../PROJECT_STRUCTURE.md
#
# Do NOT put these in the repo root or in personal/.env — that stack is n8n-only.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — app will not run without these
# -----------------------------------------------------------------------------

# Supabase — https://supabase.com (Free)
# Dashboard → Project Settings → API
# Also run db/migrations/*.sql in the SQL editor and create Storage bucket "resumes".
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this Next.js app (auth redirects, email links)
# Local:  http://localhost:3000
# Production (canonical): https://web-ashen-sigma-71.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Engine mode: mock (recommended for demos) | live (default if unset)
# mock = in-house fixture jobs + heuristic scoring — no RapidAPI/OpenAI/Resend required.
ENGINE_MODE=mock

# RapidAPI — JSearch (job boards)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# RapidAPI — Bebity / Fantastic.jobs LinkedIn jobs
# https://rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/linkedin-job-search-api
# Often the same key as RAPIDAPI_KEY. Leave LINKEDIN_RAPIDAPI_HOST empty to skip LinkedIn.
LINKEDIN_RAPIDAPI_HOST=linkedin-job-search-api.p.rapidapi.com
LINKEDIN_RAPIDAPI_KEY=

# OpenAI — per-job scoring (default model: gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vercel Cron auth — random secret; Vercel sends Authorization: Bearer <value>
# on scheduled calls to /api/cron/radar and /api/cron/maintenance
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED for production — LinkedIn API tuning (defaults work if unset)
# -----------------------------------------------------------------------------
LINKEDIN_PRIMARY_PATH=/active-jb-24h
LINKEDIN_WIDEN_PATH=/active-jb-7d
LINKEDIN_QUERY_PARAM=title_filter
LINKEDIN_LOCATION_PARAM=location_filter

# -----------------------------------------------------------------------------
# RECOMMENDED — daily digest emails (demo + sign-up still work without these)
# -----------------------------------------------------------------------------
# Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=RadarAI <onboarding@resend.dev>
# Free tier = 100 emails/day; leave headroom for Supabase auth emails on same domain
RESEND_DAILY_HARD_CAP=90

# Magic-link sign-in emails come from Supabase Auth (not these vars).
# Configure SMTP in Supabase → Authentication → SMTP if you use a custom domain.

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Telegram — users set chat id in app settings; only the bot token lives here
# Create via https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=

# OpenAI tuning (speed)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_SCORE_CONCURRENCY=12
# OPENAI_MAX_JOBS_TO_SCORE=20
# OPENAI_SCORE_DESCRIPTION_MAX_CHARS=2800

# JSearch primary fetch window: today | week | month (today = faster, fewer jobs)
# JSEARCH_PRIMARY_DATE_POSTED=today

# RapidAPI rate limits (free tier ~2–5 req/s). Serial + delay avoids HTTP 429.
# RAPIDAPI_MAX_PRIMARY_QUERIES=3
# RAPIDAPI_MAX_WIDEN_QUERIES=3
# RAPIDAPI_FETCH_DELAY_MS=1200
# RAPIDAPI_MAX_RETRIES=3
# RAPIDAPI_RETRY_BASE_MS=2500

# Daily cron (Vercel Hobby = once/day, ±59 min). Profiles match if schedule_cron
# fired within this many minutes before the cron tick.
# RADAR_TIMEZONE=America/Toronto
# RADAR_WINDOW_MINUTES=90

# -----------------------------------------------------------------------------
# NOT USED by this app (personal n8n funnel only — do not add to Vercel)
# -----------------------------------------------------------------------------
# N8N_API_URL=
# N8N_API_KEY=
# N8N_SHARED_SECRET=
# ENGINE_DOMAIN=
