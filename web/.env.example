# =============================================================================
# RadarAI SaaS — environment variables (Vercel + local dev)
# =============================================================================
#
# Local:  cp .env.example .env.local
# Vercel: Project → Settings → Environment Variables (Root Directory = web/)
#         Add every REQUIRED variable below for Production + Preview.
#
# Setup guide:  ../docs/CONNECT_SERVICES.md  (demo mode by default)
# Docs:         ../docs/PROVISIONING.md  |  ../PROJECT_STRUCTURE.md
#
# Do NOT put these in the repo root or in personal/.env — that stack is n8n-only.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — app will not run without these
# -----------------------------------------------------------------------------

# Supabase — https://supabase.com (Free)
# Dashboard → Project Settings → API
# Also run db/migrations/*.sql in the SQL editor and create Storage bucket "resumes".
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this Next.js app (auth redirects, email links)
# Local:  http://localhost:3000
# Production (canonical): https://web-ashen-sigma-71.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Engine mode — LOCAL ONLY (do not set on Vercel; production defaults to live)
# mock = fixture jobs + heuristic scoring (no Adzuna/OpenAI)
ENGINE_MODE=mock

# Adzuna — REQUIRED for live searches (production job source)
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca
# ADZUNA_MAX_PRIMARY_QUERIES=2
# ADZUNA_MAX_WIDEN_QUERIES=0
# ADZUNA_FETCH_DELAY_MS=800
# ADZUNA_MAX_DAYS_OLD=7
# ADZUNA_RESULTS_PER_PAGE=50
# ADZUNA_MAX_RETRIES=3
# ADZUNA_RETRY_BASE_MS=2500

# OpenAI — per-job scoring (default model: gpt-4o-mini)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vercel Cron auth — random secret; Vercel sends Authorization: Bearer <value>
# on scheduled calls to /api/cron/radar and /api/cron/maintenance
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# RECOMMENDED — daily digest emails (demo + sign-up still work without these)
# -----------------------------------------------------------------------------
# Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=RadarAI <onboarding@resend.dev>
# Free tier = 100 emails/day; leave headroom for Supabase auth emails on same domain
RESEND_DAILY_HARD_CAP=90

# Resend — optional digest / notification emails (NOT used for sign-in; OAuth only)

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Telegram — users set chat id in app settings; only the bot token lives here
# Create via https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=

# OpenAI tuning (speed)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_SCORE_CONCURRENCY=12
# OPENAI_MAX_JOBS_TO_SCORE=20
# OPENAI_SCORE_DESCRIPTION_MAX_CHARS=2800

# Daily cron (Vercel Hobby = once/day, ±59 min). Profiles match if schedule_cron
# fired within this many minutes before the cron tick.
# RADAR_TIMEZONE=America/Toronto
# RADAR_WINDOW_MINUTES=90

# -----------------------------------------------------------------------------
# NOT USED by this app (personal n8n funnel only — do not add to Vercel)
# -----------------------------------------------------------------------------
# N8N_API_URL=
# N8N_API_KEY=
# N8N_SHARED_SECRET=
# ENGINE_DOMAIN=
# RAPIDAPI_KEY=
# LINKEDIN_RAPIDAPI_HOST=
# LINKEDIN_RAPIDAPI_KEY=
