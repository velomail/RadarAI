{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/radar",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 8 * * *"
    }
  ]
}
